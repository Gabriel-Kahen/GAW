#!/usr/bin/env python3
"""Pinned adapter between GAW and the X-LANCE MSR inference code."""

from __future__ import annotations

import argparse
import gc
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from types import SimpleNamespace

XLANCE_COMMIT = "7f55df1f84b127aaa27f57f9436538529ad09643"
CHECKPOINT_REVISION = "c275b1fda995b98fc061ce571327f91b2ca666a2"
CHECKPOINT_REPO = "chenxie95/xlance-msr-ckpt"
MODEL_FILES = {
    "vox": ["vox_mss.pth"],
    "gtr": ["gtr_mss.pth"],
    "key": ["key_mss.pth"],
    "bass": ["bass_mss.pth"],
    "syn": ["syn_mss.pth", "syn_mss1.pth"],
    "drums": ["drums_mss.pth", "drums_mss1.pth"],
    "perc": ["perc_mss.pth", "perc_mss1.pth"],
    "orch": ["orch_mss.pth", "orch_mss1.pth"],
}


def cache_root() -> Path:
    override = os.environ.get("GAW_XLANCE_CACHE")
    if override:
        return Path(override).expanduser().resolve()
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return base / "gaw" / "xlance"


def ensure_repo() -> Path:
    override = os.environ.get("GAW_XLANCE_REPO")
    if override:
        repo = Path(override).expanduser().resolve()
        if not (repo / "inference_full.py").is_file():
            raise RuntimeError(f"GAW_XLANCE_REPO is not an X-LANCE checkout: {repo}")
        return repo
    repo = cache_root() / "xlance-msr"
    if not (repo / ".git").is_dir():
        repo.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [
                "git",
                "clone",
                "--filter=blob:none",
                "https://github.com/ModistAndrew/xlance-msr.git",
                str(repo),
            ],
            check=True,
        )
    present = subprocess.run(
        ["git", "-C", str(repo), "cat-file", "-e", f"{XLANCE_COMMIT}^{{commit}}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if present.returncode != 0:
        subprocess.run(
            ["git", "-C", str(repo), "fetch", "--depth=1", "origin", XLANCE_COMMIT],
            check=True,
        )
    subprocess.run(
        ["git", "-C", str(repo), "checkout", "--force", "--detach", XLANCE_COMMIT],
        check=True,
    )
    return repo


def checkpoint(filename: str) -> str:
    try:
        from huggingface_hub import hf_hub_download
    except ImportError as error:
        raise RuntimeError(
            "huggingface_hub is missing; install the X-LANCE Python dependencies"
        ) from error
    return hf_hub_download(
        repo_id=CHECKPOINT_REPO,
        filename=filename,
        revision=CHECKPOINT_REVISION,
        cache_dir=cache_root() / "models",
    )


def merge_chunks_without_edge_fades(chunks, chunk_size: int, overlap_size: int, np):
    """Overlap-add chunks without attenuating the beginning or end of the song."""
    hop_size = chunk_size - overlap_size
    output = np.zeros(
        (chunks[0].shape[0], hop_size * len(chunks) + overlap_size),
        dtype=chunks[0].dtype,
    )
    for index, chunk in enumerate(chunks):
        start = index * hop_size
        window = np.ones_like(chunk)
        if overlap_size > 0 and index > 0:
            window[..., :overlap_size] *= np.linspace(
                0, 1, overlap_size, dtype=chunk.dtype
            )
        if overlap_size > 0 and index + 1 < len(chunks):
            window[..., -overlap_size:] *= np.linspace(
                1, 0, overlap_size, dtype=chunk.dtype
            )
        output[..., start : start + chunk_size] += chunk * window
    return output


def load_runtime(repo: Path):
    sys.path.insert(0, str(repo))
    try:
        import inference_full
        import numpy as np
        import soundfile as sf
        import torch
    except ImportError as error:
        raise RuntimeError(
            f"X-LANCE Python dependency is missing ({error.name}); install its pinned requirements"
        ) from error

    def save_float(audio, sample_rate, output_path):
        sf.write(output_path, audio.T, sample_rate, subtype="FLOAT")

    inference_full.save_audio = save_float
    inference_full.merge_chunks = lambda chunks, chunk_size, overlap_size: (
        merge_chunks_without_edge_fades(chunks, chunk_size, overlap_size, np)
    )

    original_torch_load = torch.load

    def safe_torch_load(*args, **kwargs):
        kwargs.setdefault("weights_only", True)
        return original_torch_load(*args, **kwargs)

    torch.load = safe_torch_load

    def inference_at_model_rate(models, audio, sample_rate, batch_size):
        samples = audio.shape[-1]
        for config, model in models:
            model_rate = config["data"]["sample_rate"]
            if sample_rate != model_rate:
                audio = inference_full.librosa.resample(
                    audio, orig_sr=sample_rate, target_sr=model_rate
                )
            audio = inference_full.process_long_audio(
                model,
                audio,
                model_rate,
                chunk_duration=10.0,
                overlap=1.0,
                batch_size=batch_size,
            )
            if sample_rate != model_rate:
                audio = inference_full.librosa.resample(
                    audio, orig_sr=model_rate, target_sr=sample_rate
                )
        if samples < audio.shape[-1]:
            audio = audio[..., :samples]
        elif samples > audio.shape[-1]:
            audio = np.pad(audio, ((0, 0), (0, samples - audio.shape[-1])))
        return audio

    inference_full.inference = inference_at_model_rate
    return inference_full, np, sf, torch


def padded_input(source: Path, directory: Path, sf, np) -> tuple[Path, int, int]:
    audio, sample_rate = sf.read(source, always_2d=True, dtype="float32")
    frames = audio.shape[0]
    minimum = sample_rate * 10
    if frames >= minimum:
        return source, frames, sample_rate
    padded = np.pad(audio, ((0, minimum - frames), (0, 0)))
    path = directory / "padded-input.wav"
    sf.write(path, padded, sample_rate, subtype="FLOAT")
    return path, frames, sample_rate


def run_stage(runtime, source: Path, target: Path, *, pre=(), models=(), post=()):
    args = SimpleNamespace(
        checkpoint_pre=list(pre),
        checkpoint=list(models),
        checkpoint_post=list(post),
        input_dir=str(source),
        output_dir=str(target),
        device="cuda",
        batch_size=1,
    )
    runtime.inference_main(args)


def trim_output(path: Path, frames: int, sample_rate: int, sf):
    audio, actual_rate = sf.read(path, always_2d=True, dtype="float32")
    if actual_rate != sample_rate:
        raise RuntimeError(f"X-LANCE changed sample rate from {sample_rate} to {actual_rate}")
    sf.write(path, audio[:frames], sample_rate, subtype="FLOAT")


def split(args) -> None:
    stems = [stem for stem in args.stems.split(",") if stem]
    unknown = sorted(set(stems) - MODEL_FILES.keys())
    if not stems or unknown:
        raise RuntimeError(f"invalid stem selection: {','.join(unknown) or 'empty'}")
    source = Path(args.input).resolve()
    output = Path(args.output_dir).resolve()
    repo = ensure_repo()
    os.chdir(repo)
    runtime, np, sf, torch = load_runtime(repo)
    if not torch.cuda.is_available():
        raise RuntimeError("X-LANCE requires a CUDA-capable GPU in this integration")
    output.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="gaw-xlance-") as temporary:
        temporary = Path(temporary)
        working, frames, sample_rate = padded_input(source, temporary, sf, np)
        if args.denoise:
            denoised = temporary / "denoised.wav"
            run_stage(runtime, working, denoised, pre=[checkpoint("denoise.pth")])
            working = denoised
        for stem in stems:
            target = output / f"{stem}.wav"
            post = (
                [checkpoint("dereverb.pth")]
                if stem == "vox" and args.dereverb_vocals
                else []
            )
            run_stage(
                runtime,
                working,
                target,
                models=[checkpoint(name) for name in MODEL_FILES[stem]],
                post=post,
            )
            trim_output(target, frames, sample_rate, sf)
            print(json.dumps({"event": "stem_complete", "stem": stem}), flush=True)
            gc.collect()
            torch.cuda.empty_cache()
    print(json.dumps({"event": "complete", "stems": stems}), flush=True)


def doctor() -> None:
    repo = ensure_repo()
    os.chdir(repo)
    _, _, _, torch = load_runtime(repo)
    print(
        json.dumps(
            {
                "protocol": 1,
                "xlance_commit": XLANCE_COMMIT,
                "checkpoint_revision": CHECKPOINT_REVISION,
                "cuda": torch.cuda.is_available(),
                "gpu": torch.cuda.get_device_name(0) if torch.cuda.is_available() else None,
            }
        )
    )


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description="GAW adapter for X-LANCE MSR")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor")
    command = commands.add_parser("split")
    command.add_argument("--input", required=True)
    command.add_argument("--output-dir", required=True)
    command.add_argument("--stems", required=True)
    command.add_argument("--denoise", action="store_true")
    command.add_argument("--dereverb-vocals", action="store_true")
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        doctor() if args.command == "doctor" else split(args)
        return 0
    except Exception as error:  # The Rust side surfaces the final diagnostic line.
        print(f"{type(error).__name__}: {error}", file=sys.stderr, flush=True)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
