#!/usr/bin/env python3
"""Pinned adapter between GAW and the X-LANCE MSR inference code."""

from __future__ import annotations

import argparse
from contextlib import nullcontext
import gc
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

XLANCE_COMMIT = "7f55df1f84b127aaa27f57f9436538529ad09643"
CHECKPOINT_REVISION = "c275b1fda995b98fc061ce571327f91b2ca666a2"
CHECKPOINT_REPO = "chenxie95/xlance-msr-ckpt"
MODEL_FILES = {
    "vox": ["vox_mss.pth"],
    "gtr": ["gtr_mss.pth"],
    "key": ["key_mss.pth"],
    "bass": ["bass_mss.pth"],
    "syn": ["syn_mss.pth", "syn_mss1.pth"],
    "drums": ["drums_mss.pth", "drums_mss1.pth"],
    "perc": ["perc_mss.pth", "perc_mss1.pth"],
    "orch": ["orch_mss.pth", "orch_mss1.pth"],
}
AUDIO_BLOCK_FRAMES = 65536


def cache_root() -> Path:
    override = os.environ.get("GAW_XLANCE_CACHE")
    if override:
        return Path(override).expanduser().resolve()
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return base / "gaw" / "xlance"


def ensure_repo() -> Path:
    override = os.environ.get("GAW_XLANCE_REPO")
    if override:
        repo = Path(override).expanduser().resolve()
        if not (repo / "inference_full.py").is_file():
            raise RuntimeError(f"GAW_XLANCE_REPO is not an X-LANCE checkout: {repo}")
        return repo
    repo = cache_root() / "xlance-msr"
    if not (repo / ".git").is_dir():
        repo.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [
                "git",
                "clone",
                "--filter=blob:none",
                "https://github.com/ModistAndrew/xlance-msr.git",
                str(repo),
            ],
            check=True,
        )
    present = subprocess.run(
        ["git", "-C", str(repo), "cat-file", "-e", f"{XLANCE_COMMIT}^{{commit}}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if present.returncode != 0:
        subprocess.run(
            ["git", "-C", str(repo), "fetch", "--depth=1", "origin", XLANCE_COMMIT],
            check=True,
        )
    subprocess.run(
        ["git", "-C", str(repo), "checkout", "--force", "--detach", XLANCE_COMMIT],
        check=True,
    )
    subprocess.run(["git", "-C", str(repo), "clean", "-ffdx"], check=True)
    return repo


def repository_lock():
    if os.environ.get("GAW_XLANCE_REPO"):
        return nullcontext()
    try:
        from filelock import FileLock
    except ImportError as error:
        raise RuntimeError(
            "filelock is missing; install the locked X-LANCE Python dependencies"
        ) from error
    root = cache_root()
    root.mkdir(parents=True, exist_ok=True)
    return FileLock(root / "repository.lock", timeout=600)


def checkpoint(filename: str) -> str:
    try:
        from huggingface_hub import hf_hub_download
    except ImportError as error:
        raise RuntimeError(
            "huggingface_hub is missing; install the X-LANCE Python dependencies"
        ) from error
    return hf_hub_download(
        repo_id=CHECKPOINT_REPO,
        filename=filename,
        revision=CHECKPOINT_REVISION,
        cache_dir=cache_root() / "models",
    )


def merge_chunks_without_edge_fades(chunks, chunk_size: int, overlap_size: int, np):
    """Overlap-add chunks without attenuating the beginning or end of the song."""
    hop_size = chunk_size - overlap_size
    output = np.zeros(
        (chunks[0].shape[0], hop_size * len(chunks) + overlap_size),
        dtype=chunks[0].dtype,
    )
    for index, chunk in enumerate(chunks):
        start = index * hop_size
        window = np.ones_like(chunk)
        if overlap_size > 0 and index > 0:
            window[..., :overlap_size] *= np.linspace(
                0, 1, overlap_size, dtype=chunk.dtype
            )
        if overlap_size > 0 and index + 1 < len(chunks):
            window[..., -overlap_size:] *= np.linspace(
                1, 0, overlap_size, dtype=chunk.dtype
            )
        output[..., start : start + chunk_size] += chunk * window
    return output


def process_audio_chunks(mix, chunk_size, overlap_size, batch_size, demix, np):
    """Keep padding and inference batches bounded, even for long recordings."""
    if chunk_size <= 0 or not 0 <= overlap_size < chunk_size or batch_size <= 0:
        raise ValueError("invalid inference chunk dimensions")
    hop_size = chunk_size - overlap_size
    frames = mix.shape[-1]
    count = max(1, (frames - overlap_size + hop_size - 1) // hop_size)
    output = np.zeros(mix.shape, dtype=mix.dtype)
    fade_in = np.linspace(0, 1, overlap_size, dtype=mix.dtype)
    fade_out = np.linspace(1, 0, overlap_size, dtype=mix.dtype)
    for batch_start in range(0, count, batch_size):
        batch_count = min(batch_size, count - batch_start)
        batch = np.zeros((batch_count, mix.shape[0], chunk_size), dtype=mix.dtype)
        for offset in range(batch_count):
            start = (batch_start + offset) * hop_size
            available = min(chunk_size, frames - start)
            batch[offset, ..., :available] = mix[..., start : start + available]
        processed = demix(batch)
        for offset, chunk in enumerate(processed):
            index = batch_start + offset
            start = index * hop_size
            if overlap_size > 0 and index > 0:
                chunk[..., :overlap_size] *= fade_in
            if overlap_size > 0 and index + 1 < count:
                chunk[..., -overlap_size:] *= fade_out
            available = min(chunk_size, frames - start)
            output[..., start : start + available] += chunk[..., :available]
        print(f"Processed {batch_start + batch_count}/{count} chunks", flush=True)
    return output


def restore_audio_length(audio, samples, np):
    if samples < audio.shape[-1]:
        return audio[..., :samples]
    if samples > audio.shape[-1]:
        return np.pad(audio, ((0, 0), (0, samples - audio.shape[-1])))
    return audio


def inference_pass(runtime, config, model, audio, sample_rate, batch_size):
    """One model pass; preserve resampling rounding until the group completes."""
    model_rate = config["data"]["sample_rate"]
    if sample_rate != model_rate:
        audio = runtime.librosa.resample(
            audio, orig_sr=sample_rate, target_sr=model_rate, res_type="soxr_hq"
        )
    audio = runtime.process_long_audio(
        model, audio, model_rate, chunk_duration=10.0, overlap=1.0,
        batch_size=batch_size,
    )
    if sample_rate != model_rate:
        audio = runtime.librosa.resample(
            audio, orig_sr=model_rate, target_sr=sample_rate, res_type="soxr_hq"
        )
    return audio


def load_runtime(repo: Path):
    sys.path.insert(0, str(repo))
    try:
        import inference_full
        import numpy as np
        import soundfile as sf
        import torch
    except ImportError as error:
        raise RuntimeError(
            f"X-LANCE Python dependency is missing ({error.name}); install its pinned requirements"
        ) from error

    # X-LANCE mistakes ROCm's gfx1010 version for an NVIDIA compute
    # capability and requests flash-only SDPA, which RDNA1 does not provide.
    # Keep the upstream attention implementation but select PyTorch's math
    # kernel for ROCm. A global SDP toggle is insufficient because X-LANCE
    # overrides it at each attention call.
    if torch.version.hip is not None:
        from models.bs_roformer import attend as bs_attend

        original_attend_init = bs_attend.Attend.__init__

        def rocm_attend_init(self, *args, **kwargs):
            original_attend_init(self, *args, **kwargs)
            if self.flash:
                self.cuda_config = bs_attend.FlashAttentionConfig(
                    enable_flash=False,
                    enable_math=True,
                    enable_mem_efficient=False,
                )

        bs_attend.Attend.__init__ = rocm_attend_init

    def save_float(audio, sample_rate, output_path):
        sf.write(output_path, audio.T, sample_rate, subtype="FLOAT")

    inference_full.save_audio = save_float
    inference_full.merge_chunks = lambda chunks, chunk_size, overlap_size: (
        merge_chunks_without_edge_fades(chunks, chunk_size, overlap_size, np)
    )

    def load_audio_float32(input_path):
        audio, sample_rate = sf.read(input_path, dtype="float32")
        if audio.ndim == 1:
            audio = np.stack([audio, audio], axis=0)
        else:
            audio = audio.T
        return audio, sample_rate

    inference_full.load_audio = load_audio_float32

    original_torch_load = torch.load

    def safe_torch_load(*args, **kwargs):
        kwargs.setdefault("weights_only", True)
        return original_torch_load(*args, **kwargs)

    torch.load = safe_torch_load

    def demix_on_available_device(model, mix):
        device = next(model.parameters()).device
        mix = mix.float().to(device)
        with torch.inference_mode():
            if device.type == "cuda" and torch.version.hip is None:
                with torch.autocast(device_type="cuda", dtype=torch.float16):
                    processed = model(mix)
            else:
                processed = model(mix)
        processed = processed.cpu()
        return inference_full.F.pad(
            processed,
            (0, mix.shape[-1] - processed.shape[-1]),
            mode="constant",
            value=0,
        )

    inference_full.demix_single = demix_on_available_device

    inference_full.inference_pass = lambda config, model, audio, rate, batch_size: (
        inference_pass(inference_full, config, model, audio, rate, batch_size)
    )
    inference_full.restore_audio_length = lambda audio, samples: (
        restore_audio_length(audio, samples, np)
    )

    def inference_at_model_rate(models, audio, sample_rate, batch_size):
        samples = audio.shape[-1]
        for config, model in models:
            audio = inference_full.inference_pass(
                config, model, audio, sample_rate, batch_size
            )
        return inference_full.restore_audio_length(audio, samples)

    inference_full.inference = inference_at_model_rate

    def process_long_audio_incrementally(
        model, mix, sample_rate, chunk_duration, overlap, batch_size
    ):
        return process_audio_chunks(
            mix,
            int(chunk_duration * sample_rate),
            int(overlap * sample_rate),
            batch_size,
            lambda batch: inference_full.demix_single(model, torch.from_numpy(batch)).numpy(),
            np,
        )

    inference_full.process_long_audio = process_long_audio_incrementally
    return inference_full, np, sf, torch


def padded_input(source: Path, directory: Path, sf, np) -> tuple[Path, int, int, int]:
    info = sf.info(source)
    sample_rate, frames, channels = info.samplerate, info.frames, info.channels
    if frames == 0 or channels not in (1, 2):
        raise RuntimeError("X-LANCE input must be nonempty mono or stereo audio")
    minimum = sample_rate * 10
    if frames >= minimum:
        return source, frames, sample_rate, channels
    audio, _ = sf.read(source, always_2d=True, dtype="float32")
    padded = np.pad(audio, ((0, minimum - frames), (0, 0)))
    path = directory / "padded-input.wav"
    sf.write(path, padded, sample_rate, subtype="FLOAT")
    return path, frames, sample_rate, channels


def run_stage(
    runtime, source: Path, target: Path, device: str, *, pre=(), models=(), post=()
):
    # Upstream loads every pre/main/post model at once. Each checkpoint can
    # occupy hundreds of MiB; only one is needed for each sequential pass.
    def apply_models(paths):
        nonlocal audio
        samples = audio.shape[-1]
        for path in paths:
            loaded = runtime.load_models([path], device)
            try:
                audio = runtime.inference_pass(
                    *loaded[0], audio, sample_rate, batch_size=1
                )
            finally:
                del loaded
                gc.collect()
                if device == "cuda":
                    runtime.torch.cuda.empty_cache()
        audio = runtime.restore_audio_length(audio, samples)

    audio, sample_rate = runtime.load_audio(source)
    apply_models(pre)
    apply_models(models)
    if post:
        original = audio
        rms = runtime.calculate_rms(original)
        apply_models(post)
        if rms - runtime.calculate_rms(audio) > 10.0:
            audio = original
        del original
    runtime.save_audio(audio, sample_rate, target)


def select_device(torch) -> tuple[str, str]:
    requested = os.environ.get("GAW_XLANCE_DEVICE", "auto").strip().lower()
    if requested not in {"auto", "cuda", "rocm", "cpu"}:
        raise RuntimeError("GAW_XLANCE_DEVICE must be auto, cuda, rocm, or cpu")
    gpu_available = torch.cuda.is_available()
    rocm_runtime = torch.version.hip is not None
    if requested in {"cuda", "rocm"} and not gpu_available:
        raise RuntimeError(
            f"GAW_XLANCE_DEVICE={requested}, but that GPU backend is unavailable"
        )
    if requested == "cuda" and rocm_runtime:
        raise RuntimeError("GAW_XLANCE_DEVICE=cuda, but this is a ROCm PyTorch runtime")
    if requested == "rocm" and not rocm_runtime:
        raise RuntimeError("GAW_XLANCE_DEVICE=rocm, but this is not a ROCm PyTorch runtime")
    device = "cuda" if requested != "cpu" and gpu_available else "cpu"
    backend = "rocm" if device == "cuda" and rocm_runtime else device
    if device == "cpu":
        available = (
            len(os.sched_getaffinity(0))
            if hasattr(os, "sched_getaffinity")
            else os.cpu_count()
        )
        default_threads = max(1, (available or 1) // 2)
        value = os.environ.get("GAW_XLANCE_CPU_THREADS", str(default_threads))
        try:
            threads = int(value)
        except ValueError as error:
            raise RuntimeError("GAW_XLANCE_CPU_THREADS must be a positive integer") from error
        if threads <= 0:
            raise RuntimeError("GAW_XLANCE_CPU_THREADS must be a positive integer")
        torch.set_num_threads(threads)
    return device, backend


def trim_output(path: Path, frames: int, sample_rate: int, channels: int, sf, np):
    # Stream to a sibling file: validate completely before replacing the stem,
    # and never hold the entire output (plus a mono copy) in memory.
    with tempfile.TemporaryDirectory(prefix="trim-", dir=path.parent) as temporary:
        trimmed = Path(temporary) / "stem.wav"
        with sf.SoundFile(path) as source:
            if source.samplerate != sample_rate:
                raise RuntimeError(
                    f"X-LANCE changed sample rate from {sample_rate} to {source.samplerate}"
                )
            if source.frames < frames or source.channels != 2:
                raise RuntimeError(
                    f"X-LANCE returned invalid output shape {(source.frames, source.channels)}; expected at least {frames} stereo frames"
                )
            with sf.SoundFile(
                trimmed, "w", samplerate=sample_rate, channels=channels, subtype="FLOAT"
            ) as target:
                remaining = frames
                while remaining:
                    audio = source.read(
                        min(remaining, AUDIO_BLOCK_FRAMES),
                        always_2d=True,
                        dtype="float32",
                    )
                    if not len(audio):
                        raise RuntimeError("X-LANCE output ended unexpectedly")
                    if channels == 1:
                        audio = audio.mean(axis=1, keepdims=True, dtype=np.float32)
                    if not np.isfinite(audio).all():
                        raise RuntimeError("X-LANCE returned NaN or infinite samples")
                    target.write(audio)
                    remaining -= len(audio)
        os.replace(trimmed, path)


def split(args) -> None:
    stems = [stem for stem in args.stems.split(",") if stem]
    unknown = sorted(set(stems) - MODEL_FILES.keys())
    if not stems or unknown:
        raise RuntimeError(f"invalid stem selection: {','.join(unknown) or 'empty'}")
    source = Path(args.input).resolve()
    output = Path(args.output_dir).resolve()
    with repository_lock():
        repo = ensure_repo()
        os.chdir(repo)
        runtime, np, sf, torch = load_runtime(repo)
        device, backend = select_device(torch)
        print(
            json.dumps(
                {
                    "event": "backend",
                    "device": backend,
                    "cpu_threads": torch.get_num_threads() if device == "cpu" else None,
                }
            ),
            flush=True,
        )
        output.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix="work-", dir=output) as temporary:
            temporary = Path(temporary)
            working, frames, sample_rate, channels = padded_input(
                source, temporary, sf, np
            )
            if args.denoise:
                denoised = temporary / "denoised.wav"
                run_stage(
                    runtime,
                    working,
                    denoised,
                    device,
                    pre=[checkpoint("denoise.pth")],
                )
                working = denoised
            for stem in stems:
                target = output / f"{stem}.wav"
                post = (
                    [checkpoint("dereverb.pth")]
                    if stem == "vox" and args.dereverb_vocals
                    else []
                )
                run_stage(
                    runtime,
                    working,
                    target,
                    device,
                    models=[checkpoint(name) for name in MODEL_FILES[stem]],
                    post=post,
                )
                trim_output(target, frames, sample_rate, channels, sf, np)
                print(json.dumps({"event": "stem_complete", "stem": stem}), flush=True)
                gc.collect()
                if device == "cuda":
                    torch.cuda.empty_cache()
    print(json.dumps({"event": "complete", "stems": stems}), flush=True)


def doctor() -> None:
    with repository_lock():
        repo = ensure_repo()
        os.chdir(repo)
        _, _, _, torch = load_runtime(repo)
        device, backend = select_device(torch)
    gpu = device == "cuda"
    print(
        json.dumps(
            {
                "protocol": 1,
                "xlance_commit": XLANCE_COMMIT,
                "checkpoint_revision": CHECKPOINT_REVISION,
                "ready": True,
                "device": backend,
                "cuda": backend == "cuda",
                "rocm": backend == "rocm",
                "gpu": torch.cuda.get_device_name(0) if gpu else None,
                "cpu_threads": torch.get_num_threads() if device == "cpu" else None,
            }
        )
    )


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description="GAW adapter for X-LANCE MSR")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor")
    command = commands.add_parser("split")
    command.add_argument("--input", required=True)
    command.add_argument("--output-dir", required=True)
    command.add_argument("--stems", required=True)
    command.add_argument("--denoise", action="store_true")
    command.add_argument("--dereverb-vocals", action="store_true")
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        doctor() if args.command == "doctor" else split(args)
        return 0
    except Exception as error:  # The Rust side surfaces the final diagnostic line.
        print(f"{type(error).__name__}: {error}", file=sys.stderr, flush=True)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
